# ─── Frontend Environment Variables ────────────────────────────────────────
# Copy this to .env.local for local dev.
# For production, set these in the Vercel Dashboard → Project → Settings → Environment Variables.

# Backend URL (your Render deployment)
NEXT_PUBLIC_API_URL=https://backend-bhai.onrender.com/api/v1
NEXT_PUBLIC_BACKEND_URL=https://backend-bhai.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://backend-bhai.onrender.com

# Map provider (leaflet | mapbox | google)
NEXT_PUBLIC_MAP_PROVIDER=leaflet
